{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "0.4.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": ["https://nyx-api.chrono-ai.fun/*"],
  "action": {
    "default_title": "__MSG_openAssistant__",
    "default_icon": {
      "16": "icons/nyx-16.png",
      "32": "icons/nyx-32.png"
    }
  },
  "icons": {
    "16": "icons/nyx-16.png",
    "32": "icons/nyx-32.png",
    "48": "icons/nyx-48.png",
    "128": "icons/nyx-128.png"
  },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://nyx-api.chrono-ai.fun https://nyx-assistant-sdk-chronoai.apps.nyxid.ai; base-uri 'none'"
  }
}
